<templates>
    <t t-name="Counter">
        <selection>
            <h1>Counter</h1>
            <p>
                Count: <t t-esc="counter.count"/>
            </p>

            <div>
                <button t-on-click="counter.increment">+</button>
                 <button t-on-click="counter.decrement">-</button>
            </div>
        </selection>
    </t>
    
</templates>